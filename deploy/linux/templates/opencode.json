{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@OSC_HOME@/plugins/opencode-rate-limit-fallback"
  ],
  "provider": {
    "opencode": {
      "name": "OpenCode Zen",
      "models": {
        "x-preview-f-free": {
          "name": "Ox Alpha Free",
          "limit": {
            "context": 1000000,
            "output": 131072
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "video"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "disabled_providers": [
    "google",
    "minimax"
  ],
  "instructions": [
    "@OSC_HOME@/xdg/config/opencode/rules/worktree-scope.md",
    "@OSC_HOME@/xdg/config/opencode/rules/secrets-hygiene.md"
  ]
}
