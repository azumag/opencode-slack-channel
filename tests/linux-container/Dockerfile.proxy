# The only way out of the test network: tinyproxy, plus the mock Slack
# upstream on 127.0.0.1 (slack.mock resolves only here).
FROM ubuntu:24.04
ARG NODE_VERSION=v24.22.1
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
      tinyproxy curl ca-certificates xz-utils >/dev/null \
 && rm -rf /var/lib/apt/lists/* \
 && arch=$(uname -m | sed 's/x86_64/x64/;s/aarch64/arm64/') \
 && curl -fsSL "https://nodejs.org/dist/$NODE_VERSION/node-$NODE_VERSION-linux-$arch.tar.xz" | tar -xJ -C /tmp \
 && cp "/tmp/node-$NODE_VERSION-linux-$arch/bin/node" /usr/local/bin/node && rm -rf /tmp/node-*
COPY tinyproxy.conf /etc/tinyproxy/tinyproxy.conf
COPY tinyproxy.filter /etc/tinyproxy/filter
COPY mock-slack.mjs /mock/mock-slack.mjs
CMD ["bash", "-c", "node /mock/mock-slack.mjs > /var/log/mock.log 2>&1 & exec tinyproxy -d -c /etc/tinyproxy/tinyproxy.conf"]
